#!/bin/sh
# Hook: commit-msg
# Mục đích: Đảm bảo commit message luôn tuân thủ chuẩn Conventional Commits

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Regular expression kiểm tra Conventional Commits
regex="^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\([a-zA-Z0-9_-]+\))?: .+"

if ! echo "$commit_msg" | grep -Eq "$regex"; then
    echo "================================================================="
    echo "❌ LỖI STRICT RULE: COMMIT MESSAGE KHÔNG ĐÚNG CHUẨN!"
    echo "================================================================="
    echo "💡 Quy định: Bạn phải sử dụng chuẩn Conventional Commits."
    echo "Các tiền tố bắt buộc phải có ở đầu câu:"
    echo "   feat:     (Thêm tính năng mới)"
    echo "   fix:      (Vá lỗi/Sửa lỗi)"
    echo "   docs:     (Cập nhật tài liệu, file md...)"
    echo "   style:    (Định dạng code, css, UI...)"
    echo "   refactor: (Tái cấu trúc code)"
    echo "   perf:     (Tối ưu hiệu năng)"
    echo "   test:     (Thêm hoặc sửa unit test)"
    echo "   chore:    (Cập nhật config, build, linh tinh...)"
    echo ""
    echo "📌 Ví dụ HỢP LỆ:"
    echo "   feat: thêm màn hình đăng nhập"
    echo "   fix(auth): sửa lỗi khóa tài khoản"
    echo "   docs: cập nhật tệp SYSTEM_FEATURES.md"
    echo "================================================================="
    exit 1
fi

exit 0
